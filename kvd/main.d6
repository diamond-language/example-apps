# Starts the server. PORT and HOST come from the environment; the default
# host 127.0.0.1 accepts connections from this machine only. DATA names
# the JSON file the keys are kept in; without it they live in memory.
require "lib/kvd"

port = ENV["PORT"] == nil ? 7000 : ENV["PORT"].to_i()
host = ENV["HOST"] == nil ? "127.0.0.1" : ENV["HOST"]
data = ENV["DATA"] == "" ? nil : ENV["DATA"]

def stop()
  puts("kvd stopping")
  exit(0)
end
Signal.trap("INT", stop)
Signal.trap("TERM", stop)

store = Store.new(data)
listener = TCPServer.listen_nonblocking(port, host: host)
puts("kvd listening on #{host}:#{listener.port()} (#{store.size()} keys#{data == nil ? ", in memory" : " in #{data}"})")
Kvd.serve(listener, store)
